PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/vrr_academy
# Comma-separated browser origins, without trailing slashes.
FRONTEND_URL=http://localhost:5173
# Generate a random secret of at least 32 bytes. Required in every environment.
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Only used by npm run create-admin; remove from deployed server environment afterwards.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set to the exact trusted reverse-proxy hop count only when deployed behind one.
TRUST_PROXY=0
